# Sample environment for backend
# Change these values as needed for your deployment.
PORT=4000
JWT_SECRET=change-me-please
DB_PATH=./data/app.db
INGEST_KEY=change-me-strong
ENCRYPTION_KEY=change-me-to-a-long-random-value
CORS_ORIGIN=*

# Only used the first time the DB is seeded (empty users table).
# Has no effect on an already-seeded database - change the account's
# password via the app itself (Admin Panel / PUT /users/:id) instead.
ADMIN_SEED_PASSWORD=change-me-strong-password
USER_SEED_PASSWORD=change-me-strong-password
